# Railway จะใส่ DATABASE_URL ให้อัตโนมัติเมื่อผูก PostgreSQL เข้ากับ service
DATABASE_URL=postgresql://user:password@host:5432/railway

# รหัสผ่านเข้าใช้งานระบบ (ตั้งเองใน Railway → Variables) ถ้าเว้นว่างจะไม่มีการล็อกอิน
APP_PASSWORD=

# คีย์สำหรับเซ็นคุกกี้ ตั้งเป็นข้อความสุ่มยาว ๆ เช่นผลจาก openssl rand -hex 32
# ถ้าไม่ตั้ง จะสุ่มใหม่ทุกครั้งที่ deploy และต้องล็อกอินใหม่
SESSION_SECRET=
